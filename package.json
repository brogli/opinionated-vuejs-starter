{
  "name": "vuejs-scaffold",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:stylelint": "stylelint \"**/*.{css,vue}\" --ignore-path .gitignore --fix --cache",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "@openuxkit/themes": "1.1.0",
    "@openvue/openicons": "1.0.0",
    "@vue/devtools-api": "8.2.1",
    "openvue": "1.0.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.83.0",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-vue": "10.11.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "postcss-html": "2.0.0",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
